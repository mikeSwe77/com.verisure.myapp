  "id": "com.verisure.myapp",
  "version": "0.1.0",
  "compatibility": ">=12.11.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Verisure",
    "sv": "Verisure"
  },
  "description": {
    "en": "Control your Verisure alarm and see its sensors in Homey",
    "sv": "Styr ditt Verisure-larm och se dess sensorer i Homey"
  },
  "brandColor": "#E2001A",
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "verisure",
      "alarm",
      "security",
      "smart plug",
      "camera"
    ],
    "sv": [
      "verisure",
      "larm",
      "säkerhet",
      "smart plugg",
      "kamera"
    ]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Michael Edholm",
    "email": "michael_edholm@hotmail.com"
  },
  "support": "https://community.homey.app/",
  "api": {
    "getAccounts": {
      "method": "GET",
      "path": "/accounts"
    },
    "signOut": {
      "method": "POST",
      "path": "/accounts/sign-out"
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Alarm state was changed",
          "sv": "Larmläget ändrades"
        },
        "hint": {
          "en": "Includes who changed it and how (app, keypad, tag, Homey…).",
          "sv": "Innehåller vem som ändrade det och hur (app, knappsats, tagg, Homey…)."
        },
        "tokens": [
          {
            "name": "state",
            "type": "string",
            "title": {
              "en": "State",
              "sv": "Läge"
            },
            "example": "armed"
          },
          {
            "name": "user",
            "type": "string",
            "title": {
              "en": "Changed by",
              "sv": "Ändrat av"
            },
            "example": "Anna"
          },
          {
            "name": "via",
            "type": "string",
            "title": {
              "en": "Changed via",
              "sv": "Ändrat via"
            },
            "example": "CODE"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "alarm_changed_by"
      },
      {
        "title": {
          "en": "Arming or disarming failed",
          "sv": "På- eller avlarmning misslyckades"
        },
        "hint": {
          "en": "Runs when Homey could not change the alarm state, e.g. a wrong code or an open window.",
          "sv": "Körs när Homey inte kunde ändra larmläget, t.ex. fel kod eller ett öppet fönster."
        },
        "tokens": [
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "sv": "Orsak"
            },
            "example": {
              "en": "Verisure did not confirm the change in time."
            }
          },
          {
            "name": "target",
            "type": "string",
            "title": {
              "en": "Requested state",
              "sv": "Begärt läge"
            },
            "example": "armed"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "arm_failed"
      },
      {
        "title": {
          "en": "A device reports low battery",
          "sv": "En enhet rapporterar låg batterinivå"
        },
        "hint": {
          "en": "Any device in the installation, including ones not added to Homey such as the keypad.",
          "sv": "Alla enheter i anläggningen, även sådana som inte lagts till i Homey, t.ex. knappsatsen."
        },
        "tokens": [
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Room",
              "sv": "Rum"
            },
            "example": {
              "en": "Hall",
              "sv": "Hall"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device serial",
              "sv": "Enhetens serienummer"
            },
            "example": "1AB2 CD34"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "battery_low"
      },
      {
        "title": {
          "en": "Broadband went offline",
          "sv": "Bredbandet gick ner"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "broadband_online_false"
      },
      {
        "title": {
          "en": "Broadband came online",
          "sv": "Bredbandet kom tillbaka"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "broadband_online_true"
      },
      {
        "title": {
          "en": "Fire alarm",
          "sv": "Brandlarm"
        },
        "hint": {
          "en": "A smoke detector (or the siren) reported fire anywhere in the installation.",
          "sv": "En brandvarnare (eller sirenen) rapporterade brand någonstans i anläggningen."
        },
        "tokens": [
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Room",
              "sv": "Rum"
            },
            "example": {
              "en": "Kitchen",
              "sv": "Kök"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device serial",
              "sv": "Enhetens serienummer"
            },
            "example": "1AB2 CD34"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "fire_detected"
      },
      {
        "title": {
          "en": "Intrusion alarm",
          "sv": "Inbrottslarm"
        },
        "hint": {
          "en": "A sensor reported an intrusion while the alarm was armed.",
          "sv": "En sensor rapporterade intrång när larmet var på."
        },
        "tokens": [
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Room",
              "sv": "Rum"
            },
            "example": {
              "en": "Kitchen",
              "sv": "Kök"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device serial",
              "sv": "Enhetens serienummer"
            },
            "example": "1AB2 CD34"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "intrusion_detected"
      },
      {
        "title": {
          "en": "New picture",
          "sv": "Ny bild"
        },
        "tokens": [
          {
            "name": "image",
            "type": "image",
            "title": {
              "en": "Picture",
              "sv": "Bild"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ],
        "id": "new_image"
      },
      {
        "title": {
          "en": "Tamper alarm",
          "sv": "Sabotagelarm"
        },
        "hint": {
          "en": "A device reported tampering (cover opened or removed) anywhere in the installation.",
          "sv": "En enhet rapporterade sabotage (lock öppnat eller borttagen) någonstans i anläggningen."
        },
        "tokens": [
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Room",
              "sv": "Rum"
            },
            "example": {
              "en": "Hall",
              "sv": "Hall"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device serial",
              "sv": "Enhetens serienummer"
            },
            "example": "1AB2 CD34"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "tamper_detected"
      },
      {
        "title": {
          "en": "Water leak",
          "sv": "Vattenläcka"
        },
        "hint": {
          "en": "A water detector reported a leak anywhere in the installation.",
          "sv": "Ett vattenlarm rapporterade läckage någonstans i anläggningen."
        },
        "tokens": [
          {
            "name": "area",
            "type": "string",
            "title": {
              "en": "Room",
              "sv": "Rum"
            },
            "example": {
              "en": "Kitchen",
              "sv": "Kök"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device serial",
              "sv": "Enhetens serienummer"
            },
            "example": "1AB2 CD34"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "water_detected"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Alarm !{{can|cannot}} be armed without force",
          "sv": "Larmet !{{kan|kan inte}} larmas på utan tvång"
        },
        "hint": {
          "en": "Asks Verisure whether arming would go through, without arming. False when a door or window is open or a device reports a fault.",
          "sv": "Frågar Verisure om pålarmning skulle gå igenom, utan att larma. Falskt när en dörr eller ett fönster är öppet eller en enhet rapporterar fel."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "arm_ready"
      },
      {
        "title": {
          "en": "Broadband !{{is|is not}} online",
          "sv": "Bredbandet !{{är|är inte}} online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "broadband_online"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Arm with options",
          "sv": "Larma med val"
        },
        "titleFormatted": {
          "en": "Arm [[mode]], force arm: [[force]]",
          "sv": "Larma [[mode]], tvångslarma: [[force]]"
        },
        "hint": {
          "en": "Force arming arms even when a door or window is open or a sensor reports a fault.",
          "sv": "Tvångslarmning larmar även om en dörr eller ett fönster är öppet eller en sensor rapporterar fel."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "away",
                "label": {
                  "en": "away (fully)",
                  "sv": "borta (helt)"
                }
              },
              {
                "id": "home",
                "label": {
                  "en": "home (perimeter)",
                  "sv": "hemma (skal)"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "force",
            "title": {
              "en": "Force arm",
              "sv": "Tvångslarma"
            },
            "values": [
              {
                "id": "no",
                "label": {
                  "en": "no",
                  "sv": "nej"
                }
              },
              {
                "id": "yes",
                "label": {
                  "en": "yes",
                  "sv": "ja"
                }
              }
            ]
          }
        ],
        "id": "arm_with_options"
      },
      {
        "title": {
          "en": "Take a picture",
          "sv": "Ta en bild"
        },
        "hint": {
          "en": "Asks the camera for a new picture. It takes a few seconds; the 'New picture' trigger runs when it arrives.",
          "sv": "Ber kameran ta en ny bild. Det tar några sekunder; utlösaren 'Ny bild' körs när den kommit."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ],
        "id": "capture_image"
      },
      {
        "title": {
          "en": "Check if the alarm can be armed",
          "sv": "Kontrollera om larmet kan larmas på"
        },
        "hint": {
          "en": "Asks Verisure whether arming would go through, without arming. Returns which devices are in the way.",
          "sv": "Frågar Verisure om pålarmning skulle gå igenom, utan att larma. Returnerar vilka enheter som är i vägen."
        },
        "tokens": [
          {
            "name": "ready",
            "type": "boolean",
            "title": {
              "en": "Can be armed",
              "sv": "Kan larmas"
            }
          },
          {
            "name": "blockers",
            "type": "string",
            "title": {
              "en": "Blocking devices",
              "sv": "Hindrande enheter"
            },
            "example": {
              "en": "Entré (open)",
              "sv": "Entré (öppen)"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "check_arm_readiness"
      },
      {
        "title": {
          "en": "Update now",
          "sv": "Uppdatera nu"
        },
        "hint": {
          "en": "Fetches the latest state of every device in this installation. Each update counts towards Verisure's request limit.",
          "sv": "Hämtar senaste läget för alla enheter i anläggningen. Varje uppdatering räknas mot Verisures gräns för förfrågningar."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=alarm"
          }
        ],
        "id": "refresh_now"
      },
      {
        "title": {
          "en": "Set auto-lock",
          "sv": "Ställ in autolås"
        },
        "titleFormatted": {
          "en": "Turn auto-lock [[enabled]]",
          "sv": "Slå [[enabled]] autolås"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=smart_lock"
          },
          {
            "type": "dropdown",
            "name": "enabled",
            "title": {
              "en": "Auto-lock",
              "sv": "Autolås"
            },
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "sv": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "sv": "av"
                }
              }
            ]
          }
        ],
        "id": "set_autolock"
      }
    ]
  },
