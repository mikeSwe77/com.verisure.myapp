  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "eslint": "^7.32.0",
    "eslint-config-athom": "^3.1.5"
  },
  "funding": "https://buymeacoffee.com/mikeswe"
}
