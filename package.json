{
  "name": "com.verisure.myapp",
  "version": "0.1.0",
  "description": "Verisure alarm, sensors, smart plugs, locks and cameras for Homey",
  "author": "Michael Edholm",
  "homepage": "https://github.com/mikeSwe77/com.verisure.myapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeSwe77/com.verisure.myapp.git"
  },
  "bugs": {
    "url": "https://github.com/mikeSwe77/com.verisure.myapp/issues"
  },
  "keywords": [
    "homey",
    "homey-app",
    "verisure",
    "alarm",
    "smart-home"
  ],
  "main": "app.js",
  "scripts": {
    "lint": "eslint --ext .js --ignore-path .gitignore .",
    "test": "node --test \"test/**/*.test.js\"",
